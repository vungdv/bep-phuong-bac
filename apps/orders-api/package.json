    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "fastify": "^5",
    "node-pg-migrate": "^8",
    "pg": "^8",
    "pino": "^9",
    "zod": "^4"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "@testcontainers/postgresql": "^11",
    "@types/node": "^24",
    "@types/pg": "^8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "testcontainers": "^11",
    "tsx": "^4",
    "typescript": "^7.0.2",
