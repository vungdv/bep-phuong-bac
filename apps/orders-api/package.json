{
  "name": "@bpb/orders-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "fastify": "^5",
    "node-pg-migrate": "^8",
    "pg": "^8",
    "pino": "^9",
    "zod": "^4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11",
    "@types/node": "^24",
    "@types/pg": "^8",
    "testcontainers": "^11",
    "tsx": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
