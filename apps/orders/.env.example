# Public, non-secret build config (Vite exposes VITE_* to the bundle; never put secrets here).
# VITE_BACKEND_URL=http://localhost:5080   # default in .env.development
# Sign-in (Authorization Code + PKCE, public client: there is no client secret).
# VITE_OIDC_AUTHORITY=http://localhost:5080   # defaults to VITE_BACKEND_URL
# VITE_OIDC_CLIENT_ID=bpb-orders-ui          # default
