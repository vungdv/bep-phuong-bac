# Dev-only values. Copy to .env (gitignored) and change for any shared environment.
POSTGRES_PASSWORD=dev-postgres-pw
ADMIN_PASSWORD=Admin123!dev
SCRIPT_CLIENT_SECRET=dev-script-secret
# Shared kitchen account used by the orders app (one account for all chefs). Dev-only values.
KITCHEN_USERNAME=kitchen
KITCHEN_PASSWORD=Kitchen123!dev
# Space-separated redirect URIs of the public client bpb-orders-ui (shell and standalone dev servers). Optional.
# UI_REDIRECT_URIS=http://localhost:5173/ http://localhost:5174/
# Space- or comma-separated browser origins allowed by CORS (never *). Optional; change together with UI_REDIRECT_URIS on first start.
# CORS_ALLOWED_ORIGINS=http://localhost:5173 http://localhost:5174
# LLM Extract activity (Bpb:Llm:*). Endpoint of an OpenAI-compatible server. Default is the server running on the host
# (http://host.docker.internal:11434; never localhost, which is the container itself). For the compose `ollama` service (profile
# llm, `make llm-up`) use http://ollama:11434. A host server on another port (LM Studio: 1234) needs it here too.
# `make test-backend` overrides it with the llm-stub for its own run.
# LLM_ENDPOINT=http://host.docker.internal:11434
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_TIMEOUT_SECONDS=120
# Only for hosted providers; leave empty for a local model. Dev-only placeholder, never a real key in this file.
LLM_API_KEY=
# Host port of the llm-stub (test profile), bound to 127.0.0.1.
# LLM_STUB_PORT=5099
