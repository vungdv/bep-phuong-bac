{
  "name": "BpbOrders",
  "displayName": "Bep Phuong Bac Orders",
  "description": "Order content type and API",
  "author": "bpb",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [],
  "tags": [],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.Contents",
        "OrchardCore.ContentTypes",
        "OrchardCore.ContentFields",
        "OrchardCore.Apis.GraphQL",
        "OrchardCore.Users",
        "OrchardCore.Roles",
        "OrchardCore.OpenId",
        "OrchardCore.OpenId.Server",
        "OrchardCore.Admin",
        "OrchardCore.AdminMenu",
        "OrchardCore.Features",
        "OrchardCore.Settings",
        "OrchardCore.OpenId.Validation",
        "OrchardCore.ContentFields.Indexing.SQL",
        "OrchardCore.Cors",
        "OrchardCore.HealthChecks",
        "OrchardCore.Workflows",
        "OrchardCore.Queries",
        "OrchardCore.Queries.Sql",
        "TheAdmin",
        "OrchardCore.Navigation"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin"
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "Order",
          "DisplayName": "Order",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Securable": true,
              "Draftable": false,
              "Versionable": false
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "Order",
              "Name": "Order",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            }
          ]
        },
        {
          "Name": "ChannelMessage",
          "DisplayName": "Channel message",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Securable": true,
              "Draftable": false,
              "Versionable": false
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "ChannelMessage",
              "Name": "ChannelMessage",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            }
          ]
        }
      ],
      "ContentParts": [
        {
          "Name": "Order",
          "Settings": {},
          "ContentPartFieldDefinitionRecords": [
            {
              "FieldName": "NumericField",
              "Name": "No",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "No"
                },
                "NumericFieldSettings": {
                  "Required": true,
                  "Scale": 0,
                  "Minimum": 1
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "CustomerName",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Name"
                },
                "TextFieldSettings": {
                  "Required": true
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "NumericField",
              "Name": "Qty",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Qty"
                },
                "NumericFieldSettings": {
                  "Required": true,
                  "Scale": 0,
                  "Minimum": 1
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "Message",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Message"
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "ServiceDate",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Service date"
                },
                "TextFieldSettings": {
                  "Required": true
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "BooleanField",
              "Name": "Delivered",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Delivered"
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "SourceContentItemId",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Source content item id"
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            }
          ]
        },
        {
          "Name": "ChannelMessage",
          "Settings": {},
          "ContentPartFieldDefinitionRecords": [
            {
              "FieldName": "TextField",
              "Name": "Channel",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Channel"
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "SenderName",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Sender name"
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "Text",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Text"
                },
                "TextFieldSettings": {
                  "Required": true
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            },
            {
              "FieldName": "TextField",
              "Name": "SentAt",
              "Settings": {
                "ContentPartFieldSettings": {
                  "DisplayName": "Sent at"
                },
                "ContentIndexSettings": {
                  "Included": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "OpenIdServerSettings",
      "AccessTokenFormat": 0,
      "Authority": "",
      "AllowClientCredentialsFlow": true,
      "AllowPasswordFlow": false,
      "AllowRefreshTokenFlow": true,
      "AllowAuthorizationCodeFlow": true,
      "UseReferenceAccessTokens": false,
      "TestingModeEnabled": false,
      "TokenEndpointPath": "/connect/token",
      "EnableTokenEndpoint": true,
      "EnableAuthorizationEndpoint": true,
      "AuthorizationEndpointPath": "/connect/authorize",
      "EnableLogoutEndpoint": true,
      "LogoutEndpointPath": "/connect/logout",
      "RequireProofKeyForCodeExchange": true
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Anonymous",
          "Description": "System role. No generic ViewContent: content access is granted per type, so ChannelMessage is not readable by default.",
          "Permissions": []
        },
        {
          "Name": "Authenticated",
          "Description": "System role. No generic ViewContent: content access is granted per type, so ChannelMessage is not readable by default.",
          "Permissions": []
        },
        {
          "Name": "Kitchen",
          "Description": "Shared kitchen account: reads and updates Order content only.",
          "Permissions": [
            "AccessContentApi",
            "ApiViewContent",
            "ExecuteGraphQL",
            "View_Order",
            "Edit_Order",
            "Publish_Order"
          ]
        }
      ]
    },
    {
      "name": "OpenIdApplication",
      "ClientId": "bpb-orders-script",
      "DisplayName": "Orders scripts and tests",
      "Type": "confidential",
      "ClientSecret": "[js: configuration('Bpb:ScriptClientSecret')]",
      "AllowClientCredentialsFlow": true,
      "AllowPasswordFlow": false,
      "AllowRefreshTokenFlow": false,
      "AllowAuthorizationCodeFlow": false,
      "AllowImplicitFlow": false,
      "AllowHybridFlow": false,
      "AllowLogoutEndpoint": false,
      "RoleEntries": [
        {
          "Name": "Administrator",
          "Selected": true
        }
      ],
      "ScopeEntries": [],
      "RedirectUris": "",
      "PostLogoutRedirectUris": "",
      "RequireProofKeyForCodeExchange": false,
      "ConsentType": "explicit"
    },
    {
      "name": "OpenIdApplication",
      "ClientId": "bpb-orders-ui",
      "DisplayName": "Orders app (browser, public client)",
      "Type": "public",
      "AllowClientCredentialsFlow": false,
      "AllowPasswordFlow": false,
      "AllowRefreshTokenFlow": true,
      "AllowAuthorizationCodeFlow": true,
      "AllowImplicitFlow": false,
      "AllowHybridFlow": false,
      "AllowLogoutEndpoint": true,
      "RoleEntries": [],
      "ScopeEntries": [],
      "RedirectUris": "[js: configuration('Bpb:UiRedirectUris') || 'http://localhost:5173/ http://localhost:5174/']",
      "PostLogoutRedirectUris": "[js: configuration('Bpb:UiRedirectUris') || 'http://localhost:5173/ http://localhost:5174/']",
      "RequireProofKeyForCodeExchange": true,
      "ConsentType": "implicit"
    },
    {
      "name": "settings",
      "CorsSettings": {
        "Policies": [
          {
            "Name": "bpb",
            "AllowedOrigins": [
              "[js: (configuration('Bpb:CorsAllowedOrigins') || 'http://localhost:5173 http://localhost:5174').split(/\\s+|,/).at(0) || (configuration('Bpb:CorsAllowedOrigins') || 'http://localhost:5173 http://localhost:5174').split(/\\s+|,/).at(0)]",
              "[js: (configuration('Bpb:CorsAllowedOrigins') || 'http://localhost:5173 http://localhost:5174').split(/\\s+|,/).at(1) || (configuration('Bpb:CorsAllowedOrigins') || 'http://localhost:5173 http://localhost:5174').split(/\\s+|,/).at(0)]",
              "[js: (configuration('Bpb:CorsAllowedOrigins') || 'http://localhost:5173 http://localhost:5174').split(/\\s+|,/).at(2) || (configuration('Bpb:CorsAllowedOrigins') || 'http://localhost:5173 http://localhost:5174').split(/\\s+|,/).at(0)]",
              "[js: (configuration('Bpb:CorsAllowedOrigins') || 'http://localhost:5173 http://localhost:5174').split(/\\s+|,/).at(3) || (configuration('Bpb:CorsAllowedOrigins') || 'http://localhost:5173 http://localhost:5174').split(/\\s+|,/).at(0)]"
            ],
            "AllowAnyOrigin": false,
            "AllowedMethods": [
              "GET",
              "POST",
              "OPTIONS"
            ],
            "AllowAnyMethod": false,
            "AllowedHeaders": [
              "Authorization",
              "Content-Type",
              "traceparent"
            ],
            "AllowAnyHeader": false,
            "AllowCredentials": false,
            "IsDefaultPolicy": true,
            "ExposedHeaders": []
          }
        ]
      }
    }
  ]
}
