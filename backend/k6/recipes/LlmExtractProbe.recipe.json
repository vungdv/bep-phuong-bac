                }
              }
            }
          ]
        },
        {
          "Name": "LlmProbeResult",
          "DisplayName": "LLM probe result (test)",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Securable": true,
              "Draftable": false,
              "Versionable": false
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "LlmProbeResult",
              "Name": "LlmProbeResult",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            }
          ]
        }
      ],
      "ContentParts": [
        {
          "Name": "LlmProbe",
          "Settings": {},
          "ContentPartFieldDefinitionRecords": [
